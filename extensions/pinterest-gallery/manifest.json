{
  "manifest_version": 3,
  "name": "Marveen Gallery",
  "version": "1.1.0",
  "key": "",
  "permissions": ["contextMenus", "notifications", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost:3420/*", "http://127.0.0.1:3420/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["*://*.pinterest.com/*", "*://pinterest.com/*", "*://*.pinterest.co.uk/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
